# Google Gemini API key (optional - deterministic template fallbacks are used when omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
RATE_LIMIT_PER_MIN=60

# SQLite DB Path (optional - defaults to backend/expenseguard.db)
EXPENSEGUARD_DB=
